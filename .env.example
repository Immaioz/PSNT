# Copia questo file in `.env` (in locale) e imposta gli stessi valori
# come Environment Variables su Vercel.

# URL dell'app web pubblicata da Google Apps Script (termina con /exec)
VITE_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Token condiviso (deve combaciare con API_TOKEN in Code.gs).
# ATTENZIONE: qualsiasi variabile VITE_* finisce IN CHIARO nel bundle JS pubblico.
# Se il sito e' pubblico NON mettere qui il token: inseriscilo dalle Impostazioni
# dell'app (resta solo nel localStorage del tuo browser).
# VITE_API_TOKEN=

# Cartella (locale o remota) con images/ e videos/.
# Default: CDN jsDelivr degli asset (branch "assets" del repo).
# Locale: esercizi copianti con scripts/copy-assets.ps1 -> exercises/
VITE_ASSET_BASE=https://cdn.jsdelivr.net/gh/Immaioz/PSNT@assets/exercises/
