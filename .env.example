# Copia questo file in `.env` (in locale) e imposta gli stessi valori
# come Environment Variables su Vercel.

# URL dell'app web pubblicata da Google Apps Script (termina con /exec)
VITE_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Cartella (locale o remota) con images/ e videos/. Default: exercises/
# Esempio remoto: https://psnt.vercel.app/static/exercises/
VITE_ASSET_BASE=exercises/
